}
function applyModal(){
  const ex = $('#mExclude').checked; let n = 0;
  for (const r of M.rows){ const s = rowStatus(r); if (s.k === 'same') continue; if (ex && s.k === 'blk') continue; r.level = M.assign[r.no].level; n++; }
  closeModal(); renderBanner(); renderTable(); toast(`${n}개 지면의 낙찰 강도를 적용했습니다`);
}


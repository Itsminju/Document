<script>
(function(){
'use strict';
const DATA = JSON.parse(document.getElementById('rtb-data').textContent);
const META = DATA.meta, LEVELS = DATA.levels;
const rows = DATA.rows.map(r => ({...r}));
const BASE_ROWS = DATA.rows.map(r => ({...r}));   // '기본 데이터로' 되돌리기용 원본
const $ = s => document.querySelector(s), $$ = s => Array.from(document.querySelectorAll(s));
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

// ── 포맷 ──
const nf = n => Math.round(n).toLocaleString('ko-KR');
const fx = (n,d) => (Number.isFinite(n) ? n : 0).toFixed(d);
const pc = (n,d=1) => fx(n,d) + '%';
const div = (a,b) => b ? a/b : 0;
const lvObj = l => LEVELS.find(x => x.level === l) || {level:l, target:null};
const lvTarget = l => lvObj(l).target;
const lvName = l => l === 0 ? '기본단가' : '레벨 ' + l;
const lvCell = l => l === 0 ? '알고리즘 기본단가' : `레벨 ${l} (${lvTarget(l)}%)`;
const MAXLV = Math.max(...LEVELS.map(l => l.level));

// ── 파생값 ──
const capEcpm = r => r.maxCpc * r.hctr * 10;           // 최대 소진 CPC × hCTR(%) × 1,000
const baseEcpm = r => r.maxBid * r.hctr * 10;          // 최대 입찰가 × hCTR × 1,000
function reqEcpm(r, l){                                // 레벨별 필요 입찰 eCPM (예시 계산식)
  if (l === 0) return baseEcpm(r);
  const t = lvTarget(l);
  if (!(r.prevWinRate > 0 && r.bidEcpm > 0) || t == null) return null;
  return r.bidEcpm * Math.pow(t / r.prevWinRate, 0.2);
}
const blocked = (r,l) => { const v = reqEcpm(r,l); return v != null && v > capEcpm(r) + 0.01; };
const maxFeasible = r => { let m = 0; for (const L of LEVELS) if (!blocked(r, L.level)) m = Math.max(m, L.level); return m; };
function isUnder(r){ const t = lvTarget(r.level); return r.level > 0 && t != null && r.prevWinRate < t * 0.9; }
function isAtCap(r){ return isUnder(r) && r.bidEcpm >= capEcpm(r) - 0.01; }

// ── 구분(RTB) 표기 ──
const RTB_LABEL = {GoogleRTB:'Google', KAKAORTB:'Kakao'};
const rtbLabel = v => RTB_LABEL[v] || v;

// ── 컬럼 정의 (CSV 순서 + 구분 · 시장가) ──
const COLS = [
  {k:'rtb', l:'구분', a:'c', f:r=>rtbLabel(r.rtb), t:()=>'-'},
  {k:'grade', l:'지면 등급', a:'c', f:r=>r.grade, t:()=>'-', sort:r=>+r.grade},
  {k:'cat', l:'지면 카테고리', a:'c', f:r=>esc(r.cat||'기타'), t:()=>'-', sort:r=>r.cat||''},
  {k:'name', l:'지면명', a:'l', f:r=>esc(r.name), t:()=>''},
  {k:'device', l:'디바이스', a:'c', f:r=>r.device, t:()=>'-'},
  {k:'req', l:'요청수', f:r=>nf(r.req), t:s=>nf(s.req), sort:r=>r.req, m:'요청수'},
  {k:'bid', l:'입찰수', f:r=>nf(r.bid), t:s=>nf(s.bid), sort:r=>r.bid, m:'입찰수'},
  {k:'bidRate', l:'입찰율', f:r=>pc(div(r.bid,r.req)*100), t:s=>pc(div(s.bid,s.req)*100), sort:r=>div(r.bid,r.req), m:'입찰율', u:'%', v:r=>div(r.bid,r.req)*100},
  {k:'win', l:'낙찰수', f:r=>nf(r.win), t:s=>nf(s.win), sort:r=>r.win, m:'낙찰수'},
  {k:'winRate', l:'낙찰율', f:r=>pc(div(r.win,r.bid)*100), t:s=>pc(div(s.win,s.bid)*100), sort:r=>div(r.win,r.bid), m:'낙찰율', u:'%', v:r=>div(r.win,r.bid)*100},
  {k:'level', l:'목표 낙찰 강도', a:'l', f:r=>r.fixed?'<span class="muted">수정 불가</span>':lvCell(r.level), t:()=>'-', sort:r=>r.fixed?-1:r.level},
  {k:'winEcpm', l:'낙찰 eCPM', f:r=>fx(r.winEcpm,3), t:s=>fx(div(s.spend,s.imp)*1000,3), sort:r=>r.winEcpm, m:'낙찰 eCPM'},
  {k:'bidEcpm', l:'입찰 eCPM', f:r=>fx(r.bidEcpm,3), t:s=>fx(div(s.bidEcpmImp,s.imp),3), sort:r=>r.bidEcpm, m:'입찰 eCPM'},
  {k:'marketPrice', l:'시장가', f:r=>r.marketPrice==null?'-':fx(r.marketPrice,3), t:()=>'-', sort:r=>r.marketPrice??-1, dimIf:r=>r.marketPrice==null, m:'시장가'},
  {k:'maxBid', l:'최대 입찰가', f:r=>fx(r.maxBid,2), t:()=>'-', sort:r=>r.maxBid, m:'최대 입찰가'},
  {k:'margin', l:'수익률', f:r=>pc(r.margin), t:s=>pc(div(s.marginSpend,s.spend)), sort:r=>r.margin, m:'수익률', u:'%'},
  {k:'roas', l:'ROAS', f:r=>pc(r.roas), t:s=>pc(div(s.cv,s.spend)*100), sort:r=>r.roas, m:'ROAS', u:'%'},
  {k:'iroas', l:'간접 ROAS', f:r=>pc(r.iroas), t:s=>pc(div(s.icv,s.spend)*100), sort:r=>r.iroas, m:'간접 ROAS', u:'%'},
  {k:'kpiRate', l:'KPI 달성률', f:r=>pc(r.kpiRate), t:s=>pc(div(s.cv,s.spend)*100/META.roasTarget*100), sort:r=>r.kpiRate, m:'KPI 달성률', u:'%'},
  {k:'spend', l:'소진액', f:r=>nf(r.spend), t:s=>nf(s.spend), sort:r=>r.spend, m:'소진액'},
  {k:'imp', l:'노출수', f:r=>nf(r.imp), t:s=>nf(s.imp), sort:r=>r.imp, m:'노출수'},
  {k:'clk', l:'클릭수', f:r=>nf(r.clk), t:s=>nf(s.clk), sort:r=>r.clk, m:'클릭수'},
  {k:'share', l:'소진비율', f:(r,s)=>pc(div(r.spend,s.spend)*100,2), t:()=>'-', sort:r=>r.spend},
  {k:'avgCpc', l:'평균 소진(CPC)', f:r=>fx(div(r.spend,r.clk),1), t:s=>fx(div(s.spend,s.clk),1), sort:r=>div(r.spend,r.clk), m:'평균 소진(CPC)', v:r=>div(r.spend,r.clk)},
  {k:'maxCpc', l:'최대 소진(CPC)', f:r=>fx(r.maxCpc,2), t:()=>'-', sort:r=>r.maxCpc, m:'최대 소진(CPC)'},
  {k:'ctr', l:'클릭율(CTR)', f:r=>pc(div(r.clk,r.imp)*100,3), t:s=>pc(div(s.clk,s.imp)*100,3), sort:r=>div(r.clk,r.imp), m:'클릭율(CTR)', u:'%', v:r=>div(r.clk,r.imp)*100},
  {k:'conv', l:'전환수', f:r=>nf(r.conv), t:s=>nf(s.conv), sort:r=>r.conv, m:'전환수'},
  {k:'iconv', l:'간접 전환수', f:r=>nf(r.iconv), t:s=>nf(s.iconv), sort:r=>r.iconv, m:'간접 전환수'},
  {k:'cvr', l:'전환율', f:r=>pc(div(r.conv,r.clk)*100,2), t:s=>pc(div(s.conv,s.clk)*100,2), sort:r=>div(r.conv,r.clk), m:'전환율', u:'%', v:r=>div(r.conv,r.clk)*100},
  {k:'icvr', l:'간접 전환율', f:r=>pc(div(r.iconv,r.clk)*100,2), t:s=>pc(div(s.iconv,s.clk)*100,2), sort:r=>div(r.iconv,r.clk), m:'간접 전환율', u:'%', v:r=>div(r.iconv,r.clk)*100},
  {k:'cv', l:'전환금액', f:r=>nf(r.cv), t:s=>nf(s.cv), sort:r=>r.cv, m:'전환금액'},
  {k:'icv', l:'간접 전환금액', f:r=>nf(r.icv), t:s=>nf(s.icv), sort:r=>r.icv, m:'간접 전환금액'}
];
const METRICS = COLS.filter(c => c.m);
const LOCKED_COLS = ['name']; // 지면명은 항상 표시 (행 식별자)
const colByKey = k => COLS.find(c => c.k === k);
const visibleCols = () => state.cols.map(colByKey).filter(Boolean);
const metricVal = (c, r) => c.v ? c.v(r) : (r[c.k] ?? NaN);

// ── 상태 ──
const blankFilters = () => ({
  from: META.periodFrom, to: META.periodTo,
  rtb: ['KAKAORTB','GoogleRTB'], dev: ['WEB','MOB','APP'],
  grade: 'all', cat: 'all', lvFrom: 0, lvTo: MAXLV, q: '', match: 'all',
  conds: [{m:'winRate', op:'lt', v:''}]
});
const state = {
  draft: blankFilters(), applied: blankFilters(), quick: null,
  sel: new Set(), sort: {k:null, dir:1}, // NO 컬럼 삭제 — 기본은 정렬 없음(데이터 원본 순서)
  cols: COLS.map(c => c.k), // 표시 중인 컬럼 키 (순서 포함) — 컬럼 수정에서 변경
  page: 0, pageSize: 50, // 페이지네이션
  quickOn: null, myQuicks: [], // 빠른 조건
  views: [{name:'뷰 버전_1'},{name:'뷰 버전_2'},{name:'뷰 버전_3'}], view: 0
};
state.views.forEach(v => v.filters = blankFilters());

// ── 필터 ──
function passes(r, f){
  if (!f.rtb.includes(r.rtb)) return false;
  if (!f.dev.includes(r.deviceType)) return false;
  if (f.grade !== 'all' && r.grade !== f.grade) return false;
  if (f.cat !== 'all' && (r.cat || '기타') !== f.cat) return false;
  if (r.level < f.lvFrom || r.level > f.lvTo) return false;
  if (f.q.trim()){
    const terms = f.q.split(',').map(s => s.trim()).filter(Boolean);
    if (!terms.some(t => r.name.includes(t))) return false;
  }
  const active = f.conds.filter(c => c.v !== '' && !isNaN(+c.v));
  if (active.length){
    const res = active.map(c => { const col = COLS.find(x => x.k === c.m); const v = metricVal(col, r); return c.op === 'gte' ? v >= +c.v : v < +c.v; });
    if (f.match === 'all' ? !res.every(Boolean) : !res.some(Boolean)) return false;
  }
  return true;
}
function visibleRows(){
  let list = rows.filter(r => passes(r, state.applied));
  if (state.quick === 'cap') list = list.filter(isAtCap);
  if (state.quick === 'under') list = list.filter(isUnder);
  const col = COLS.find(c => c.k === state.sort.k);
  if (col && col.sort) list.sort((a,b) => (col.sort(a) > col.sort(b) ? 1 : col.sort(a) < col.sort(b) ? -1 : 0) * state.sort.dir);
  return list;
}
function sums(list){
  const s = {req:0,bid:0,win:0,spend:0,imp:0,clk:0,conv:0,iconv:0,cv:0,icv:0,bidEcpmImp:0,marginSpend:0};
  for (const r of list){ for (const k of ['req','bid','win','spend','imp','clk','conv','iconv','cv','icv']) s[k] += r[k]; s.bidEcpmImp += r.bidEcpm * r.imp; s.marginSpend += r.margin * r.spend; }
  return s;
}

// ── 렌더: 배너 · KPI ──
function renderBanner(){
  /* [보류] 목표 낙찰률 미달 안내 배너 — 삭제 아님, 나중에 다시 사용 예정.
     아래 주석을 해제하면 원래대로 동작합니다.

  const under = rows.filter(isUnder), cap = rows.filter(isAtCap);
  const el = $('#banner');
  if (!under.length){ el.innerHTML = ''; return; }
  el.innerHTML = `<div class="banner"><div class="ico">!</div><div>
    <h3>목표 낙찰률 미달 ${under.length}개 — 그중 ${cap.length}개는 마진 상한에 도달해 입찰가를 더 올릴 수 없습니다</h3>
    <p>이 화면에서 할 수 있는 조치는 목표 레벨을 낮추는 것입니다. 낮추면 입찰가가 하향돼 수익률이 오르고, 대신 낙찰 물량은 줄어듭니다.</p></div>
    <div class="acts"><button class="btn amber" data-quick="cap" ${cap.length?'':'disabled'}>최대가 입찰 중 지면 확인 &gt;</button><button class="btn amSec" data-quick="under">낙찰 목표 미달 지면 확인 &gt;</button></div></div>`;
  */
  $('#banner').innerHTML = '';
}
// KPI 카드 = 5개 지표 × 2개 구분(Google · Kakao) = 10장.
// 한 구분을 더 늘리려면 KPI_SEGS 에 한 줄만 추가하면 됩니다.
const KPI_METRICS = [{k:'req', l:'요청수'}, {k:'bidRate', l:'입찰율'}, {k:'winRate', l:'낙찰율'}, {k:'spend', l:'소진액'}, {k:'roas', l:'ROAS'}];
const KPI_SEGS = [{s:'g', l:'Google', rtb:'GoogleRTB'}, {s:'k', l:'Kakao', rtb:'KAKAORTB'}];
const KPIS = KPI_SEGS.flatMap(sg => KPI_METRICS.map(m => ({k: sg.s + '_' + m.k, l: m.l, m: m.k, seg: sg})));
const kpiName = k => { const x = KPIS.find(y => y.k === k); return x ? x.seg.l + ' ' + x.l : k; };

// 한 구분(Google 또는 Kakao)의 지면 목록으로 카드 5장의 값을 계산
function kpiValues(list){
  const s = sums(list);
  const top2 = [...list].sort((a,b)=>b.spend-a.spend).slice(0,2).reduce((a,r)=>a+r.spend,0);
  const roas = div(s.cv, s.spend) * 100;
  const low = roas < META.roasTarget;
  return { low, V: {
    req:     [nf(s.req), '', `지면 ${nf(list.length)}개 합계`],
    bidRate: [pc(div(s.bid,s.req)*100), '', `입찰 ${nf(s.bid)}건`],
    winRate: [pc(div(s.win,s.bid)*100), '', `낙찰 ${nf(s.win)}건`],
    spend:   [nf(s.spend)+'원', '', list.length>2 ? `상위 2개 지면이 ${pc(div(top2,s.spend)*100)}` : ''],
    roas:    [pc(roas,0), low ? '<span class="chip rd">미달</span>' : '', `목표 ${META.roasTarget}% 대비 ${pc(roas/META.roasTarget*100,0)} 달성`]
  }};
}
function renderKpis(list){
  KPI_SEGS.forEach(sg => {
    const sub = list.filter(r => r.rtb === sg.rtb);
    const { low, V } = kpiValues(sub);
    KPI_METRICS.forEach(m => {
      const key = sg.s + '_' + m.k;
      const el = tileEl('k_' + key); if (!el) return;
      const [v, b, s2] = V[m.k];
      const nm = sg.l + ' ' + m.l;
      el.innerHTML = `<div class="lb"><span class="knm"><span class="kseg ${sg.s}">${sg.l}</span>${m.l}</span>${b}</div>`
        + (LAY.on ? `<button class="krm" data-rmtile="k_${key}" aria-label="${nm} 숨기기">×</button>` : '')
        + `<div class="v" style="${m.k==='roas'&&low?'color:var(--rd)':''}">${v}</div><div class="s">${s2 || '해당 지면 없음'}</div>`;
    });
  });
}

// ── 렌더: 테이블 ──
function renderTable(){
  const list = visibleRows(), s = sums(list), CS = visibleCols();
  // 페이지 슬라이스 — 합계행·KPI는 조회 결과 전체 기준, 표는 현재 페이지만
  const pages = Math.max(1, Math.ceil(list.length / state.pageSize));
  if (state.page > pages - 1) state.page = pages - 1;
  const from = state.page * state.pageSize;
  const page = list.slice(from, from + state.pageSize);
  const allSel = page.length && page.every(r => state.sel.has(r.no));
  const th = `<thead><tr><th class="stk0 nosort" style="width:44px"><input type="checkbox" class="cb" id="cbAll" ${allSel?'checked':''} aria-label="전체 선택"></th>` +

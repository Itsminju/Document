function openGuide(){ $('#gdOverlay').classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeGuide(){ $('#gdOverlay').classList.remove('open'); document.body.style.overflow = ''; }
function rowStatus(r){
  const a = M.assign[r.no], L = a.level;
  const req = reqEcpm(r, L), cap = capEcpm(r);
  if (L === r.level) {
    const trend = !isUnder(r) ? (r.level>0 && r.prevWinRate > lvTarget(r.level)*1.3 ? '하향 중 유지' : '유지') : (isAtCap(r) ? '상한 도달 유지' : '상향 중 유지');
    return {k:'same', label:'변경 없음', cls:'gy', sub:trend, req, cap};
  }
  if (req == null) return {k:'na', label:'데이터 부족', cls:'gy', sub:'전일 낙찰률 없음', req, cap};
  if (req > cap + 0.01) return {k:'blk', label:'달성 불가 예상', cls:'rd', sub:`레벨 ${maxFeasible(r)} 이하면 가능`, req, cap};
  return req > r.bidEcpm ? {k:'up', label:'가능 · 상향', cls:'gn', req, cap} : {k:'dn', label:'가능 · 하향', cls:'gn', req, cap};
}
function toneOf(b, n){ return b === 0 ? 'gn' : (b / n < 0.5 ? 'am' : 'rd'); }
function renderModal(){

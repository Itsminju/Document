function renderCols(){
  // 좌: 전체 지표 체크박스 (COLS 원본 순서 고정)
  $('#cmGrid').innerHTML = COLS.map(c => {
    const lock = LOCKED_COLS.includes(c.k);
    return `<label class="chk ${lock?'lock':''}" title="${lock?'항상 표시되는 컬럼입니다':''}">
      <input type="checkbox" data-ck="${c.k}" ${CM.on.has(c.k)?'checked':''} ${lock?'disabled':''}> <span>${c.l}</span></label>`;
  }).join('');
  // 우: 선택한 컬럼 목록 (드래그로 순서 변경)
  const sel = CM.order.filter(k => CM.on.has(k));
  $('#cmCount').textContent = sel.length;
  $('#cmList').innerHTML = sel.map(k => {
    const c = colByKey(k), lock = LOCKED_COLS.includes(k);
    return `<div class="colrow" draggable="true" data-ck="${k}">
      <span class="gr" aria-hidden="true">≡</span><span class="nm2">${c.l}</span>
      ${lock ? '<span class="lk" title="항상 표시">🔒</span>' : `<button class="rm" data-rm="${k}" aria-label="${c.l} 제외">×</button>`}</div>`;
  }).join('');
}
function moveCol(from, to){
  if (from === to) return;
  const o = CM.order, i = o.indexOf(from);
  o.splice(i, 1);
  const j = o.indexOf(to);
  o.splice(j < i ? j : j + 1, 0, from);
}
function applyCols(){
  const next = CM.order.filter(k => CM.on.has(k));
  if (!next.length){ toast('컬럼은 1개 이상 선택해야 합니다'); return; }
  state.cols = next;
  if (state.sort.k && !next.includes(state.sort.k)) state.sort = {k:null, dir:1}; // 숨긴 컬럼 정렬 해제
  closeCols(); renderTable(); toast(`${next.length}개 컬럼을 적용했습니다`);
}


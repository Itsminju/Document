function wbBars(G){
  const list = G.etc ? [...G.top, G.etc] : G.top;
  const keys = WB.mx, max = Math.max(...list.flatMap(g => keys.map(k => agmOf(k).f(g.s))), 1);
  const tot = G.total || 1;
  if (WB.vert){
    const cols = list.map(g => `<div class="pvCol">
      <div class="cv">${fmtAgShort(keys[0], agmOf(keys[0]).f(g.s))}</div>
      <div class="cbars">${keys.map((k, i) => {
        const v = agmOf(k).f(g.s);
        return `<div class="cbar ${g.etc ? 'etc' : i ? 'b2' : ''}" style="height:${Math.max(v / max * 100, 1)}%" title="${agmOf(k).l} ${fmtAg(k, v)}"></div>`;
      }).join('')}</div></div>`).join('');
    return `<div class="pvCols">${cols}</div><div class="pvColLbs">${list.map(g => `<div class="pvColLb" title="${esc(g.l)}">${esc(g.l)}</div>`).join('')}</div>`;
  }
  return `<div class="pvRows">` + list.map(g => `<div class="pvRow">
    <div class="pvLb" title="${esc(g.l)}">${esc(g.l)}</div>
    <div class="pvTrack">${keys.map((k, i) => {
      const v = agmOf(k).f(g.s);
      return `<div class="pvLine"><div class="pvBar ${g.etc ? 'etc' : i ? 'b2' : ''}" style="width:${Math.max(v / max * 100, 0.6)}%" title="${agmOf(k).l} ${fmtAg(k, v)}"></div>
        <span class="pvVal">${fmtAgShort(k, v)}</span>${i === 0 && agmOf(k).u !== '%' ? `<span class="pvShare">${pc(div(v, tot) * 100)}</span>` : ''}</div>`;
    }).join('')}</div>${wbNumCell(g)}</div>`).join('') + `</div>`;
}
function wbShare(G){
  const list = G.etc ? [...G.top, G.etc] : G.top;
  const tot = list.reduce((a, g) => a + g.v, 0) || 1;
  const CL = ['#2563EB','#4F87F5','#7FA9F8','#A9C5FA','#CBDCFC','#93B4FB','#B9CDFB','#D6DAE0','#E4E7EB','#EDEFF2'];
  const col = (g, i) => g.etc ? '#D6DAE0' : CL[i % CL.length];
  return `<div class="pvShareBar">${list.map((g, i) =>
      `<span style="width:${div(g.v, tot) * 100}%;background:${col(g, i)}" title="${esc(g.l)} ${pc(div(g.v, tot) * 100)}"></span>`).join('')}</div>
    <div class="pvLegend">${list.map((g, i) => `<div class="lg"><span class="sw" style="background:${col(g, i)}"></span>
      <span title="${esc(g.l)}">${esc(g.l)}</span><span class="lgv">${fmtAgShort(WB.mx[0], g.v)}</span><span class="lgp">${pc(div(g.v, tot) * 100)}</span></div>`).join('')}</div>`;
}
function wbLine(G){
  const list = G.etc ? [...G.top, G.etc] : G.top;
  const W = 760, H = 250, PL = 54, PR = 16, PT = 16, PB = 34;
  const keys = WB.mx;
  const max = Math.max(...list.flatMap(g => keys.map(k => agmOf(k).f(g.s))), 1);
  const x = i => PL + (W - PL - PR) * (list.length < 2 ? .5 : i / (list.length - 1));
  const y = v => PT + (H - PT - PB) * (1 - v / max);
  const CLR = ['#2563EB', '#93B4FB'];
  const paths = keys.map((k, ki) => {
    const pts = list.map((g, i) => `${x(i).toFixed(1)},${y(agmOf(k).f(g.s)).toFixed(1)}`).join(' ');
    const dots = list.map((g, i) => `<circle cx="${x(i).toFixed(1)}" cy="${y(agmOf(k).f(g.s)).toFixed(1)}" r="3.6" fill="${CLR[ki]}"><title>${esc(g.l)} · ${fmtAg(k, agmOf(k).f(g.s))}</title></circle>`).join('');
    return `<polyline points="${pts}" fill="none" stroke="${CLR[ki]}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>${dots}`;
  }).join('');
  const grid = [0, .25, .5, .75, 1].map(t => `<line x1="${PL}" y1="${(PT + (H - PT - PB) * t).toFixed(1)}" x2="${W - PR}" y2="${(PT + (H - PT - PB) * t).toFixed(1)}" stroke="#EDEFF2"/>
    <text x="${PL - 8}" y="${(PT + (H - PT - PB) * t + 4).toFixed(1)}" text-anchor="end" font-size="10" fill="#9CA3AF">${fmtAgShort(keys[0], max * (1 - t))}</text>`).join('');
  const labs = list.map((g, i) => `<text x="${x(i).toFixed(1)}" y="${H - 10}" text-anchor="middle" font-size="10.5" fill="#6B7280">${esc(g.l.length > 9 ? g.l.slice(0, 8) + '…' : g.l)}</text>`).join('');
  return `<svg class="pvSvg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">${grid}${paths}${labs}</svg>`;
}
function wbScatter(G){
  const list = G.top;
  const W = 760, H = 250, PL = 56, PR = 16, PT = 16, PB = 38;
  const kx = WB.mx[0], ky = WB.mn || WB.mx[0];
  const xs = list.map(g => agmOf(kx).f(g.s)), ys = list.map(g => agmOf(ky).f(g.s));
  const mx = Math.max(...xs, 1), my = Math.max(...ys, 1);
  const X = v => PL + (W - PL - PR) * (v / mx);
  const Y = v => PT + (H - PT - PB) * (1 - v / my);
  const grid = [0, .5, 1].map(t => `<line x1="${PL}" y1="${(PT + (H - PT - PB) * t).toFixed(1)}" x2="${W - PR}" y2="${(PT + (H - PT - PB) * t).toFixed(1)}" stroke="#EDEFF2"/>
    <text x="${PL - 8}" y="${(PT + (H - PT - PB) * t + 4).toFixed(1)}" text-anchor="end" font-size="10" fill="#9CA3AF">${fmtAgShort(ky, my * (1 - t))}</text>`).join('');
  const pts = list.map(g => `<g><circle cx="${X(agmOf(kx).f(g.s)).toFixed(1)}" cy="${Y(agmOf(ky).f(g.s)).toFixed(1)}" r="6" fill="#2563EB" fill-opacity=".75"><title>${esc(g.l)} · ${agmOf(kx).l} ${fmtAg(kx, agmOf(kx).f(g.s))} · ${agmOf(ky).l} ${fmtAg(ky, agmOf(ky).f(g.s))}</title></circle></g>`).join('');
  return `<svg class="pvSvg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">${grid}${pts}
    <text x="${W - PR}" y="${H - 8}" text-anchor="end" font-size="10.5" fill="#6B7280">${agmOf(kx).l} →</text></svg>`;
}


      return `<div class="r ${s.k==='blk'?'blk':''} ${ind?'ind':''}" data-no="${r.no}">
        <div></div>
        <div><div class="nm" title="${esc(r.name)}">${esc(r.name)}</div><div class="sm">${r.grade==='99'?'미분류':r.grade+'등급'} · ${r.deviceType} · ${rtbLabel(r.rtb)}</div></div>
        <div class="num" style="font-weight:700;font-size:13px;${s.k==='blk'?'color:var(--rd)':''}">${r.prevWinRate==null?'-':pc(r.prevWinRate)}</div>
        <div><div style="font-weight:500">${lvName(r.level)}</div><div class="sm">${r.level===0?'목표 없음':'목표 '+lvTarget(r.level)+'%'}</div></div>
        <div><select class="lvsel ${ind?'ind':''} ${s.k==='blk'?'blk':''}" data-no="${r.no}" aria-label="${esc(r.name)} 변경 레벨">${opts(r)}</select>${ind?`<div class="sm" style="color:var(--bl);font-weight:500;margin-top:3px">개별 변경 · 일괄값 ${lvName(M.bulk)}</div>`:''}</div>

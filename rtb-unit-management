function buildFilterOptions(){
  const grades = [...new Set(rows.map(r=>r.grade))].sort((a,b)=>+a-+b);
  $('#fGrade').innerHTML = `<option value="all">전체 (${grades.length})</option>` + grades.map(g=>`<option value="${g}">${g==='99'?'미분류(99)':g+'등급'}</option>`).join('');
  const cats = [...new Set(rows.map(r => r.cat || '기타'))].sort((a,b) => a === '기타' ? 1 : b === '기타' ? -1 : a.localeCompare(b,'ko'));
  $('#fCat').innerHTML = `<option value="all">전체 (${cats.length})</option>` + cats.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');
}


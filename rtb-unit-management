const catHit = (rules, t) => { for (let i = 0; i < rules.length; i++) if (rules[i][1].test(t)) return rules[i][0]; return null; };
function guessCat(name){
  const kakao = /^RTB_(다음카카오|카카오톡?)_/.test(name);
  const core = name.replace(/^(RTB|SK플래닛)_[^_]*_/, '').replace(/\s*\(\d+\)\s*$/, '');
  return catHit(CAT_BRAND, core) || catHit(CAT_RULES, core) || (kakao ? '포털·플랫폼' : '기타');
}

// ── 값 정리 : 내려받기 CSV 는 ="1,234" 처럼 엑셀 수식으로 감싸 옵니다 ──
const dClean = v => String(v == null ? '' : v).replace(/^="|"$/g, '').trim();
const dNum = v => {
  const s = dClean(v).replace(/,/g, '').replace(/%$/, '');
  if (s === '' || s === '-') return 0;
  const n = parseFloat(s);
  return Number.isFinite(n) ? n : 0;
};
const dR = (n, d) => { const p = Math.pow(10, d); return Math.round(n * p) / p; };

// ── CSV ──
function parseCsvText(s){
  const out = []; let row = [], cell = '', q = false;
  for (let i = 0; i < s.length; i++){
    const c = s[i];
    if (q){ if (c === '"'){ if (s[i+1] === '"'){ cell += '"'; i++; } else q = false; } else cell += c; }
    else if (c === '"') q = true;
    else if (c === ',') { row.push(cell); cell = ''; }
    else if (c === '\r') { /* skip */ }
    else if (c === '\n'){ row.push(cell); out.push(row); row = []; cell = ''; }
    else cell += c;
  }
  if (cell !== '' || row.length){ row.push(cell); out.push(row); }
  return out.filter(r => r.length > 1);
}
// 내려받기 파일은 EUC-KR, 직접 만든 파일은 UTF-8 인 경우가 많아 둘 다 받습니다.
function decodeText(buf){
  const utf8 = new TextDecoder('utf-8').decode(buf);
  if (utf8.indexOf('�') < 0) return utf8.replace(/^﻿/, '');
  try { return new TextDecoder('euc-kr').decode(buf); } catch (e) { return utf8; }
}

// ── XLSX : ZIP + SpreadsheetML 최소 구현 (외부 라이브러리 없음) ──
async function inflateEntry(u8, method){
  if (method === 0) return u8;
  if (typeof DecompressionStream === 'undefined')
    throw new Error('이 브라우저에서는 XLSX 를 열 수 없습니다. CSV 로 올려 주세요');
  const ab = await new Response(new Blob([u8]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).arrayBuffer();
  return new Uint8Array(ab);
}
async function unzip(buf){
  const u8 = new Uint8Array(buf), dv = new DataView(buf);
  let eocd = -1;
  for (let i = u8.length - 22; i >= 0 && i > u8.length - 66000; i--) if (dv.getUint32(i, true) === 0x06054b50){ eocd = i; break; }
  if (eocd < 0) throw new Error('XLSX 파일 구조를 읽지 못했습니다');
  const n = dv.getUint16(eocd + 10, true);
  let off = dv.getUint32(eocd + 16, true);
  const files = {};
  const td = new TextDecoder();
  for (let i = 0; i < n && off + 46 <= u8.length; i++){
    if (dv.getUint32(off, true) !== 0x02014b50) break;
    const method = dv.getUint16(off + 10, true);
    const csize = dv.getUint32(off + 20, true);
    const nameLen = dv.getUint16(off + 28, true);
    const extLen = dv.getUint16(off + 30, true);
    const cmtLen = dv.getUint16(off + 32, true);
    const lho = dv.getUint32(off + 42, true);
    const name = td.decode(u8.subarray(off + 46, off + 46 + nameLen));
    const lNameLen = dv.getUint16(lho + 26, true), lExtLen = dv.getUint16(lho + 28, true);
    const start = lho + 30 + lNameLen + lExtLen;
    files[name] = { method: method, data: u8.subarray(start, start + csize) };
    off += 46 + nameLen + extLen + cmtLen;
  }
  return files;
}
const colIdx = ref => { let n = 0; for (let i = 0; i < ref.length; i++){ const c = ref.charCodeAt(i); if (c >= 65 && c <= 90) n = n * 26 + (c - 64); else break; } return n - 1; };
async function readXlsx(buf){
  const files = await unzip(buf), td = new TextDecoder();
  const get = async n => files[n] ? td.decode(await inflateEntry(files[n].data, files[n].method)) : '';
  let sheet = 'xl/worksheets/sheet1.xml';
  if (!files[sheet]) sheet = Object.keys(files).filter(k => /^xl\/worksheets\/.+\.xml$/.test(k)).sort()[0];
  if (!sheet) throw new Error('시트를 찾지 못했습니다');
  const SS = [], ssXml = await get('xl/sharedStrings.xml');
  if (ssXml){
    const sd = new DOMParser().parseFromString(ssXml, 'application/xml');
    const si = sd.getElementsByTagName('si');
    for (let i = 0; i < si.length; i++){
      const t = si[i].getElementsByTagName('t'); let s = '';
      for (let j = 0; j < t.length; j++) s += t[j].textContent;
      SS.push(s);
    }
  }
  // 백분율 셀은 60.8% 가 0.608 로 저장됩니다 — 스타일에서 % 서식을 찾아 되돌립니다
  const pctStyle = new Set();
  const stXml = await get('xl/styles.xml');
  if (stXml){
    const sd = new DOMParser().parseFromString(stXml, 'application/xml');
    const isPct = { '9': true, '10': true };   // 9·10 은 엑셀 기본 백분율 서식
    const nf = sd.getElementsByTagName('numFmt');
    for (let i = 0; i < nf.length; i++){
      const code = (nf[i].getAttribute('formatCode') || '').replace(/"[^"]*"/g, '');
      if (code.indexOf('%') >= 0) isPct[nf[i].getAttribute('numFmtId')] = true;
    }
    const xfs = sd.getElementsByTagName('cellXfs')[0];
    if (xfs){
      const xf = xfs.getElementsByTagName('xf');
      for (let i = 0; i < xf.length; i++) if (isPct[xf[i].getAttribute('numFmtId')]) pctStyle.add(String(i));
    }
  }
  const doc = new DOMParser().parseFromString(await get(sheet), 'application/xml');
  const rs = doc.getElementsByTagName('row'), out = [];
  for (let i = 0; i < rs.length; i++){
    const cs = rs[i].getElementsByTagName('c'), arr = [];
    for (let j = 0; j < cs.length; j++){
      const c = cs[j], t = c.getAttribute('t'), ref = c.getAttribute('r') || '';
      const at = ref ? colIdx(ref) : arr.length;
      let v = '';
      if (t === 'inlineStr'){ const e = c.getElementsByTagName('t')[0]; v = e ? e.textContent : ''; }
      else {
        const e = c.getElementsByTagName('v')[0]; v = e ? e.textContent : '';
        if (t === 's') v = SS[+v] == null ? '' : SS[+v];
        else if (v !== '' && pctStyle.has(c.getAttribute('s') || '0')){
          const n = parseFloat(v);
          if (Number.isFinite(n)) v = (Math.round(n * 1e8) / 1e6) + '%';   // 0.608 → '60.8%'
        }
      }
      arr[at >= 0 ? at : arr.length] = v;
    }
    for (let k = 0; k < arr.length; k++) if (arr[k] === undefined) arr[k] = '';
    out.push(arr);
  }
  return out;
}

// ── 컬럼 이름 → 필드 ──
const HEAD_MAP = {
  no:['NO','번호'], grade:['지면 등급'], name:['지면명'], device:['디바이스'],
  req:['요청수'], bid:['입찰수'], bidRate:['입찰율','입찰률'], win:['낙찰수'], winRate:['낙찰율','낙찰률'],
  level:['목표 낙찰 강도'], winEcpm:['낙찰 eCPM'], bidEcpm:['입찰 eCPM'], maxBid:['최대 입찰가'],
  margin:['수익률'], roas:['ROAS'], iroas:['간접 ROAS'], kpiRate:['KPI 달성률'],
  spend:['소진액'], imp:['노출수'], clk:['클릭수'], maxCpc:['최대 소진(CPC)'], ctr:['클릭율(CTR)','클릭률(CTR)'],
  conv:['전환수'], iconv:['간접 전환수'], cv:['전환금액'], icv:['간접 전환금액']
};
const hNorm = s => dClean(s).replace(/\s+/g, ' ').toLowerCase();

function buildRowsFrom(table){
  const hi = table.findIndex(r => r.some(c => hNorm(c) === '지면명'));
  if (hi < 0) throw new Error('‘지면명’ 컬럼을 찾지 못했습니다 — RTB 지면 리포트 내려받기 파일인지 확인해 주세요');
  const H = table[hi].map(hNorm), idx = {};
  Object.keys(HEAD_MAP).forEach(k => {
    for (let i = 0; i < HEAD_MAP[k].length; i++){
      const at = H.indexOf(hNorm(HEAD_MAP[k][i]));
      if (at >= 0){ idx[k] = at; break; }
    }
  });
  if (idx.name == null || idx.req == null) throw new Error('‘지면명’·‘요청수’ 컬럼이 모두 필요합니다');

  const body = table.slice(hi + 1).filter(r => {
    const nm = dClean(r[idx.name]);
    return nm !== '' && nm !== '총합계' && dClean(r[0]).toUpperCase() !== 'TOTAL';
  });
  if (!body.length) throw new Error('읽을 수 있는 지면 행이 없습니다');

  const seen = new Set();
  const out = body.map((c, i) => {
    const raw = k => idx[k] == null ? '' : c[idx[k]];
    const n = k => dNum(raw(k));
    const name = dClean(raw('name'));
    const dev = dClean(raw('device'));
    const lvTxt = dClean(raw('level'));

    // 구분 · 디바이스 유형 · 카테고리는 내려받기 파일에 없어 지면명으로 추정합니다
    const rtb = /카카오/.test(name) ? 'KAKAORTB' : 'GoogleRTB';
    let deviceType;
    if (name.indexOf('RTB_WEB_') === 0) deviceType = 'WEB';
    else if (name.indexOf('RTB_MOB_') === 0) deviceType = 'MOB';
    else if (name.indexOf('RTB_APP_') === 0) deviceType = 'APP';
    else if (/(^|_)(APP|app|AOS|aos|ios|iOS)(_|\b)/.test(name)) deviceType = 'APP';
    else deviceType = dev === 'PC' ? 'WEB' : 'MOB';

    const fixed = lvTxt === '수정 불가';
    const lm = lvTxt.match(/(?:Lv\.?|레벨)\s*(\d+)/i);
    const level = lm ? +lm[1] : 0;

    const maxBid = dClean(raw('maxBid')) === '-' ? 0 : dNum(raw('maxBid'));
    const bidEcpm = dNum(raw('bidEcpm'));
    const ctr = n('ctr');
    let hctr = (maxBid > 0 && bidEcpm > 0) ? bidEcpm / (maxBid * 10) : (ctr > 0 ? ctr : 0.5);
    hctr = dR(Math.min(hctr, 100), 3);

    let no = Math.round(dNum(raw('no'))) || (i + 1);
    while (seen.has(no)) no++;
    seen.add(no);

    const r = {
      no: no, rtb: rtb, grade: dClean(raw('grade')) || '99', name: name, device: dev, deviceType: deviceType,
      req: dNum(raw('req')), bid: dNum(raw('bid')), win: dNum(raw('win')),
      level: level,
      winEcpm: dR(dNum(raw('winEcpm')), 3), bidEcpm: dR(bidEcpm, 3), marketPrice: null, maxBid: dR(maxBid, 2),
      margin: dR(n('margin'), 1), roas: dR(n('roas'), 1), iroas: dR(n('iroas'), 1), kpiRate: dR(n('kpiRate'), 1),
      spend: dNum(raw('spend')), imp: dNum(raw('imp')), clk: dNum(raw('clk')),
      maxCpc: dClean(raw('maxCpc')) === '-' ? 0 : dR(dNum(raw('maxCpc')), 2),
      conv: dNum(raw('conv')), iconv: dNum(raw('iconv')), cv: dNum(raw('cv')), icv: dNum(raw('icv')),
      prevWinRate: dR(n('winRate'), 1), hctr: hctr, cat: guessCat(name)
    };
    if (fixed) r.fixed = true;
    return r;
  });
  return out;
}

// ── 적용 ──
function applyRows(newRows, label){
  rows.length = 0;
  for (let i = 0; i < newRows.length; i++) rows.push(newRows[i]);
  META.isSample = false;
  buildFilterOptions();
  // 새 데이터에 없는 등급·카테고리가 저장돼 있으면 '전체' 로 되돌립니다
  const gs = new Set(rows.map(r => r.grade)), cs = new Set(rows.map(r => r.cat || '기타'));
  const fix = f => { if (!f) return;
    if (f.grade !== 'all' && !gs.has(f.grade)) f.grade = 'all';
    if (f.cat !== 'all' && !cs.has(f.cat)) f.cat = 'all'; };
  state.views.forEach(v => fix(v.filters)); fix(state.draft); fix(state.applied);
  state.sel.clear(); state.page = 0; state.quick = null;
  $('#sampleTag').hidden = true;
  $('#dataSrc').textContent = label;
  fillPanel(state.draft); updateResultText(); renderBanner(); renderLayout();
}

async function loadDataFile(file){
  try {
    const buf = await file.arrayBuffer();
    const u8 = new Uint8Array(buf);
    let table;
    if (u8[0] === 0x50 && u8[1] === 0x4B) table = await readXlsx(buf);          // PK — xlsx
    else if (/\.xls$/i.test(file.name)) throw new Error('예전 .xls 형식은 지원하지 않습니다 — .xlsx 또는 CSV 로 저장해 올려 주세요');
    else table = parseCsvText(decodeText(buf));
    const nr = buildRowsFrom(table);
    applyRows(nr, file.name + ' · 지면 ' + nf(nr.length) + '개');
    $('#btnResetData').hidden = false;
    toast('‘' + file.name + '’ 을(를) 불러왔습니다 — 지면 ' + nf(nr.length) + '개');
  } catch (e){
    toast('불러오기 실패 — ' + (e && e.message ? e.message : e));
  }
}



      WFIL.map(g => `<div class="g">${g.g}</div>` + g.vs.map(v =>
        `<button data-wb="pickf" data-f="${g.f}" data-v="${v}">${v}</button>`).join('')).join('') + `</div>` : ''}</span>`;
  // 4 정렬 · 개수
  const showSort = WB.type !== 'num';
  $('#wbSortStep').hidden = !showSort;
  $('#wbSort').hidden = !showSort;
  $('#wbSort').innerHTML = !showSort ? '' :
    `<span class="seg2"><button data-wb="dir" data-v="desc" class="${WB.dir === 'desc' ? 'on' : ''}">높은 순</button><button data-wb="dir" data-v="asc" class="${WB.dir === 'asc' ? 'on' : ''}">낮은 순</button></span>
     <span class="seg2">${[5,10,20].map(n => `<button data-wb="n" data-v="${n}" class="${WB.n === n ? 'on' : ''}">${n}</button>`).join('')}</span>
     <button class="swt ${WB.etc ? 'on' : ''}" data-wb="etc"><span class="tr"></span>나머지는 ‘기타’</button>`;
  // 5 이름
  wbSyncName();

function renderPager(total, pages, from){
  const to = Math.min(from + state.pageSize, total);
  const block = Math.floor(state.page / PAGE_BLOCK);
  const first = block * PAGE_BLOCK, last = Math.min(first + PAGE_BLOCK, pages);
  const nums = [];
  for (let i = first; i < last; i++) nums.push(`<button class="pg ${i===state.page?'on':''}" data-pg="${i}">${i+1}</button>`);
  $('#pager').innerHTML = `
    <span class="sz">표시할 행 수
      <select id="pgSize">${PAGE_SIZES.map(n => `<option value="${n}" ${n===state.pageSize?'selected':''}>${n}</option>`).join('')}</select>

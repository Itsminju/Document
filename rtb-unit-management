// ── 레이아웃 (보드 그리드) ──
// KPI 카드 · 추가된 위젯 · 조회 패널 · 테이블이 모두 같은 5칸 격자의 '타일'이라
// 서로 자리를 바꿀 수 있고, 위젯은 차지하는 칸 수(폭)도 조절됩니다.
const BOARD_COLS = 5;
const PANELS = [];   // 추가된 위젯만 (조회 패널·지면 테이블은 고정이라 보드에 없음)

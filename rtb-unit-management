        <div><span class="chip ${s.cls}">${s.label}</span>${s.sub?`<div class="sm" style="margin-top:3px;${s.k==='blk'?'color:var(--rd)':''}">${s.sub}</div>`:''}</div>
      </div>`; }).join('') : `<div class="empty">해당하는 지면이 없습니다</div>`);
  // 셀렉트 값 세팅
  $$('#mTable select.lvsel').forEach(sel => sel.value = M.assign[+sel.dataset.no].level);
  // 요약 · 버튼
  $('#mExcludeTxt').textContent = `달성 불가 예상 지면(${blk.length}개)은 제외하고 적용`;

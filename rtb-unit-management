  // 뷰 탭
  $('#viewTabs').addEventListener('click', e => {
    if (e.target.id === 'addView'){ readPanel(); state.views.push({name:`뷰 버전_${state.views.length+1}`, filters: JSON.parse(JSON.stringify(state.draft))}); state.view = state.views.length-1; renderTabs(); toast('현재 조건으로 새 뷰를 만들었습니다'); return; }
    const d = e.target.closest('[data-delview]');
    if (d){
      if (state.views.length <= 1){ toast('뷰는 최소 1개가 필요합니다'); return; }
      const i = +d.dataset.delview, name = state.views[i].name;
      state.views.splice(i, 1);
      state.view = state.view > i ? state.view - 1 : Math.min(state.view, state.views.length - 1);
      state.draft = JSON.parse(JSON.stringify(state.views[state.view].filters));
      state.applied = JSON.parse(JSON.stringify(state.draft));
      state.quick = null; state.sel.clear();
      fillPanel(state.draft); updateResultText(); renderTabs(); renderTable();
      toast(`'${name}' 뷰를 삭제했습니다`);
      return;
    }
    const b = e.target.closest('[data-view]'); if (!b) return;
    state.view = +b.dataset.view; state.draft = JSON.parse(JSON.stringify(state.views[state.view].filters)); state.applied = JSON.parse(JSON.stringify(state.draft));
    state.quick = null; state.sel.clear(); state.page = 0; fillPanel(state.draft); updateResultText(); renderTabs(); renderTable();
  });

  // 배너 · 결과줄
  document.addEventListener('click', e => {
    const q = e.target.closest('[data-quick]'); if (q){ state.quick = q.dataset.quick; state.sel.clear(); state.page = 0; renderTable(); $('#tableWrap').scrollIntoView({behavior:'smooth', block:'start'}); }
    if (e.target.id === 'clearQuick'){ state.quick = null; state.page = 0; renderTable(); }
    const t = e.target.closest('[data-toast]'); if (t) toast(t.dataset.toast);
  });

  // 테이블
  $('#grid').addEventListener('click', e => {
    const th = e.target.closest('th[data-k]');
    if (th && !th.classList.contains('nosort')){ const k = th.dataset.k; state.sort = {k, dir: state.sort.k===k ? -state.sort.dir : (k==='no'?1:-1)}; state.page = 0; renderTable(); return; }
    if (e.target.id === 'cbAll'){ const all = visibleRows(); const page = all.slice(state.page*state.pageSize, (state.page+1)*state.pageSize); // 전체 선택은 현재 페이지 기준
      if (e.target.checked) page.forEach(r=>state.sel.add(r.no)); else page.forEach(r=>state.sel.delete(r.no)); renderTable(); return; }
    const tr = e.target.closest('tr[data-no]'); if (!tr) return;
    const no = +tr.dataset.no; state.sel.has(no) ? state.sel.delete(no) : state.sel.add(no); renderTable();
  });
  $('#btnClearSel').onclick = () => { state.sel.clear(); renderTable(); };
  $('#bulkCb').onclick = e => { e.preventDefault(); state.sel.clear(); renderTable(); };
  $('#btnBulkAdjust').onclick = openModal;

  // 모달
  $('#cells').addEventListener('click', e => { const c = e.target.closest('[data-lv]'); if (!c) return; const L = +c.dataset.lv; M.bulk = L; M.rows.forEach(r => M.assign[r.no] = {level:L, ind:false}); renderModal(); });
  $('#pgUp').onclick = () => { if (M.page>0){ M.page--; renderModal(); } };
  $('#pgDn').onclick = () => { if (M.page < Math.ceil(LEVELS.length/7)-1){ M.page++; renderModal(); } };
  $('#cells').addEventListener('wheel', e => { e.preventDefault(); const pages = Math.ceil(LEVELS.length/7); const p = Math.max(0, Math.min(pages-1, M.page + (e.deltaY>0?1:-1))); if (p!==M.page){ M.page=p; renderModal(); } }, {passive:false});
  $('#mTabs').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (b){ M.tab = b.dataset.tab; renderModal(); } });
  $('#mTable').addEventListener('change', e => { if (!e.target.matches('select.lvsel')) return; const no = +e.target.dataset.no, v = +e.target.value; M.assign[no] = {level:v, ind: M.bulk == null || v !== M.bulk}; renderModal(); });
  $('#mExclude').onchange = renderModal;
  $('#mApply').onclick = applyModal;
  $('#mCancel').onclick = closeModal; $('#mClose').onclick = closeModal;

  // 위젯 만들기
  // 데이터 교체 (시안 확인용)
  $('#dataSrc').textContent = '기본 데이터 · 지면 ' + nf(rows.length) + '개';
  $('#btnLoadData').onclick = () => $('#dataFile').click();
  $('#dataFile').onchange = e => { const f = e.target.files[0]; if (f) loadDataFile(f); e.target.value = ''; };
  $('#btnResetData').onclick = () => {
    applyRows(BASE_ROWS.map(r => ({...r})), '기본 데이터 · 지면 ' + nf(BASE_ROWS.length) + '개');
    $('#btnResetData').hidden = true; toast('기본 데이터로 되돌렸습니다');
  };
  const dbar = $('#devbar');
  ['dragenter','dragover'].forEach(t => dbar.addEventListener(t, e => { e.preventDefault(); dbar.classList.add('over'); }));
  ['dragleave','drop'].forEach(t => dbar.addEventListener(t, e => { e.preventDefault(); dbar.classList.remove('over'); }));
  dbar.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f) loadDataFile(f); });

  $('#btnAddWidget').onclick = openWb;
  $('#wbClose').onclick = closeWb; $('#wbCancel').onclick = closeWb;
  $('#wbAdd').onclick = addWidget;
  $('#wbTpl').onclick = () => toast('템플릿 저장은 다음 단계에서 연결됩니다');
  $('#wbOverlay').addEventListener('click', e => { if (e.target.id === 'wbOverlay') closeWb(); });
  $('#wbName').addEventListener('input', e => { WB.named = true; WB.name = e.target.value; renderWbPreview(); });
  $('#wbOverlay').addEventListener('change', e => {
    const k = e.target.dataset.wb; if (!k) return;
    if (k === 'dim') WB.dim = e.target.value;
    if (k === 'mx0'){
      WB.mx[0] = e.target.value;
      if (WB.mx[1] && agmOf(WB.mx[1]).u !== agmOf(WB.mx[0]).u) WB.mx.length = 1; // 단위 달라지면 두 번째 해제
    }
    if (k === 'mx1') WB.mx[1] = e.target.value;
    if (k === 'mn') WB.mn = e.target.value;
    renderWb();
  });
  $('#wbOverlay').addEventListener('click', e => {
    const t = e.target.closest('[data-ct]');
    if (t){
      WB.type = t.dataset.ct;
      if (WB.mx.length > wbMaxX()) WB.mx.length = wbMaxX();
      if (WB.type === 'scat' && !WB.mn) WB.mn = 'roas';
      renderWb(); return;
    }
    const b = e.target.closest('[data-wb]'); 
    if (!b || b.tagName === 'SELECT'){ if (WB.menu && !e.target.closest('.faddWrap')){ WB.menu = false; renderWb(); } return; }
    const k = b.dataset.wb;
    if (k === 'swap') WB.vert = !WB.vert;
    else if (k === 'addx'){ const u = agmOf(WB.mx[0]).u; const alt = AGM.find(m => m.u === u && m.k !== WB.mx[0]); if (alt) WB.mx[1] = alt.k; }
    else if (k === 'rmx1') WB.mx.length = 1;
    else if (k === 'rmf') WB.filters.splice(+b.dataset.i, 1);
    else if (k === 'addf') WB.menu = !WB.menu;
    else if (k === 'pickf'){
      const f = b.dataset.f, v = b.dataset.v;
      WB.filters = WB.filters.filter(x => x.f !== f).concat([{f, v}]); // 같은 종류는 하나만
      WB.menu = false;
    }
    else if (k === 'dir') WB.dir = b.dataset.v;
    else if (k === 'n') WB.n = +b.dataset.v;
    else if (k === 'etc') WB.etc = !WB.etc;
    else return;
    renderWb();
  });

  // 레이아웃 편집 — 보드 전체가 하나의 드래그 시스템
  $('#btnLayout').onclick = () => {
    LAY.on = !LAY.on; renderLayout();
    toast(LAY.on ? '레이아웃 편집 모드입니다' : '레이아웃을 저장했습니다');
  };
  $('#board').addEventListener('click', e => {
    const sp = e.target.closest('[data-span]');
    if (sp){ LAY.span[sp.closest('.tile').dataset.tile] = +sp.dataset.span; renderLayout(); return; }
    const r = e.target.closest('[data-rmtile]');
    if (r){ const k = r.dataset.rmtile; LAY.hidden.add(k); renderLayout(); toast(`'${tileName(k)}' 타일을 숨겼습니다`); }
  });
  $('#layBar').addEventListener('click', e => {
    const r = e.target.closest('[data-restore]'); if (!r) return;
    LAY.hidden.delete(r.dataset.restore); renderLayout();
  });
  $('#board').addEventListener('dragstart', e => {
    if (!LAY.on) return;
    const bar = e.target.closest('.pnlBar');
    const tile = bar ? bar.closest('.tile') : e.target.closest('.tile.kpi');
    if (!tile) return;
    LAY.drag = tile.dataset.tile; tile.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  $('#board').addEventListener('dragover', e => {
    if (!LAY.drag) return;
    e.preventDefault(); e.dataTransfer.dropEffect = 'move';
    LAY.dropAt = dropSpot(e.clientX, e.clientY);
    showDropBar(LAY.dropAt);
  });
  $('#board').addEventListener('dragleave', e => {
    if (e.target === $('#board') && !$('#board').contains(e.relatedTarget)) hideDropBar();
  });
  $('#board').addEventListener('drop', e => {
    if (!LAY.drag) return;
    e.preventDefault();
    const spot = dropSpot(e.clientX, e.clientY);
    const moved = moveTileTo(LAY.drag, spot.i);
    LAY.drag = null; hideDropBar();
    TILES().forEach(x => x.classList.remove('dragging'));
    if (moved) renderLayout();
  });
  $('#board').addEventListener('dragend', () => {
    LAY.drag = null; hideDropBar();
    TILES().forEach(x => x.classList.remove('dragging'));
  });

  /* [보류] 컬럼 수정 모달 — 기존 기능과 동일하여 토스트로 대체.
     다시 쓰려면 지면관리 툴바의 컬럼설정 버튼을 data-toast 대신 id="btnCols" 로 되돌리고
     아래 주석을 해제하세요.

  $('#btnCols').onclick = openCols;
  $('#cmClose').onclick = closeCols; $('#cmCancel').onclick = closeCols;
  $('#cmApply').onclick = applyCols;
  $('#cmOverlay').addEventListener('click', e => { if (e.target.id === 'cmOverlay') closeCols(); });
  $('#cmGrid').addEventListener('change', e => {
    const k = e.target.dataset.ck; if (!k) return;
    e.target.checked ? CM.on.add(k) : CM.on.delete(k);
    renderCols();
  });
  $('#cmList').addEventListener('click', e => {
    const b = e.target.closest('[data-rm]'); if (!b) return;
    CM.on.delete(b.dataset.rm); renderCols();
  });
  $('#cmList').addEventListener('dragstart', e => {
    const row = e.target.closest('.colrow'); if (!row) return;
    CM.drag = row.dataset.ck; row.classList.add('drag');
    e.dataTransfer.effectAllowed = 'move';
  });
  $('#cmList').addEventListener('dragover', e => {
    const row = e.target.closest('.colrow'); if (!row || !CM.drag) return;
    e.preventDefault(); e.dataTransfer.dropEffect = 'move';
    $$('#cmList .colrow').forEach(x => x.classList.toggle('over', x === row && x.dataset.ck !== CM.drag));
  });
  $('#cmList').addEventListener('drop', e => {
    const row = e.target.closest('.colrow'); if (!row || !CM.drag) return;
    e.preventDefault(); moveCol(CM.drag, row.dataset.ck); CM.drag = null; renderCols();
  });
  $('#cmList').addEventListener('dragend', () => { CM.drag = null; renderCols(); });
  // 추가 지표 설정 펼침
  $$('.cmExtra .cv').forEach(b => b.onclick = () => b.closest('.row2').classList.toggle('open'));
  */

  // 안내 모달
  $('#btnGuide').onclick = openGuide;
  $('#gdClose').onclick = closeGuide; $('#gdOk').onclick = closeGuide;
  $('#gdOverlay').addEventListener('click', e => { if (e.target.id === 'gdOverlay') closeGuide(); });
  $('#overlay').addEventListener('click', e => { if (e.target.id === 'overlay') closeModal(); });
  document.addEventListener('keydown', e => {
    // if ($('#cmOverlay').classList.contains('open') && e.key === 'Escape'){ closeCols(); return; } // [보류] 컬럼 수정
    if ($('#wbOverlay').classList.contains('open') && e.key === 'Escape'){ closeWb(); return; }
    if ($('#gdOverlay').classList.contains('open') && e.key === 'Escape'){ closeGuide(); return; }
    if (!$('#overlay').classList.contains('open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowUp' && e.target.tagName !== 'SELECT'){ e.preventDefault(); $('#pgUp').click(); }
    if (e.key === 'ArrowDown' && e.target.tagName !== 'SELECT'){ e.preventDefault(); $('#pgDn').click(); }
  });
}
init();
})();
</script>
</body>
</html>
